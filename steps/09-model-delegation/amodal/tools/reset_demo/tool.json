{
  "description": "Reset the demo: remove every submission, document, claim, risk finding, and event, then load the demo dataset again. Fired only from the UI's Reset demo data action, after the operator confirms; not listed in any agent's tools.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "runningLabel": "Resetting the demo data",
  "completedLabel": "Reset the demo data",
  "timeout": 120000,
  "execution": "durable",
  "uses": {
    "tools": [
      "store__submissions__list",
      "store__submissions__remove",
      "store__submissions__set",
      "store__documents__list",
      "store__documents__remove",
      "store__documents__set",
      "store__claims__list",
      "store__claims__remove",
      "store__claims__set",
      "store__risk_findings__list",
      "store__risk_findings__remove",
      "store__events__list",
      "store__events__remove",
      "store__events__set"
    ]
  },
  "triggers": [{ "kind": "invoke" }]
}
