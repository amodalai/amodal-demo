# Gmail connection (amodal/connections/gmail/spec.json). All optional. With
# none set, the demo runs offline: Sync inbox falls back to the demo dataset
# and Send reply writes to the dev outbox. Copy to `.env` and fill in to talk
# to a real mailbox.

# OAuth access token for the connected broker mailbox.
# Scopes: gmail.readonly to sync; add gmail.send to reply. Expires ~hourly.
GMAIL_ACCESS_TOKEN=

# The From: identity for outgoing replies (required to actually send).
GMAIL_FROM_ADDRESS=underwriting@yourcarrier.com

# Where the driver writes sends when no token is set (offline dev outbox).
GMAIL_DEV_OUTBOX=.amodal/gmail-outbox
